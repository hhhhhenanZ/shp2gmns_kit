{
  "region": {
    "name": "CMAP",
    "model": "emme_cmap",
    "description": "CMAP trip-based model (ON TO 2050 update), c25q4 scenario 100 (2019), Emme highway network",
    "conformity_cycle": "c25q4",
    "scenario": 100,
    "base_year": 2019
  },
  "references": {
    "G": {
      "title": "CMAP Travel Demand Model Data User Guide (c25q4)",
      "file": "data/input/cmap/docs/data_user_guide.html",
      "url": "https://datahub.cmap.illinois.gov/documents/a14d641dbe184704ab597479b103986c/explore"
    },
    "A": {
      "title": "ON TO 2050 plan update: Travel demand model appendix",
      "file": "data/input/cmap/docs/ON-TO-2050-Update-Travel-Demand-Model-Documentation-Appendix.pdf",
      "url": "https://cmap.illinois.gov/wp-content/uploads/ON-TO-2050-Update-Travel-Demand-Model-Documentation-Appendix.pdf"
    },
    "C": {
      "title": "CMAP trip-based model code (Ftime_capacity.py, TOD_network_prep.py, vdf_tod.in)",
      "file": "data/input/cmap/docs/cmap_code/",
      "url": "https://github.com/CMAP-REPOS/cmap_trip-based_model/tree/e52b3185920b139fb77983a74458b05fa4923890/Database"
    }
  },
  "input": {
    "links_shapefile": {
      "PM": "data/input/cmap/network/highwayshp_pmpk/emme_links.shp"
    },
    "nodes_shapefile": {
      "PM": "data/input/cmap/network/highwayshp_pmpk/emme_nodes.shp"
    },
    "turns_dbf": {
      "PM": "data/input/cmap/network/highwayshp_pmpk/emme_turns.dbf"
    },
    "extra_attributes": {
      "PM": "data/input/cmap/network/emmenet_highway/attribs_p7.txt"
    },
    "emme_network": {
      "PM": "data/input/cmap/network/emmenet_highway/network_p7.txt"
    }
  },
  "output": {
    "root": "data/output/cmap",
    "geometry_separate_file": true,
    "csv_bom": true
  },
  "periods": {
    "PM": {
      "emme_period": 7,
      "start_hour": 16,
      "end_hour": 18,
      "hours": 2
    }
  },
  "crs": {
    "source": "EPSG:26771",
    "target": "EPSG:4326"
  },
  "zones": {
    "first_zone_id": 1,
    "last_zone_id": 3649,
    "zone_flag_field": "ISZONE"
  },
  "link_fields": {
    "id": "ID",
    "inode": "INODE",
    "jnode": "JNODE",
    "length_mi": "LENGTH",
    "modes": "MODES",
    "lanes": "LANES",
    "vdf": "VDF",
    "volume": "DATA1",
    "time": "TIMAU"
  },
  "node_fields": {
    "id": "ID",
    "x": "X",
    "y": "Y",
    "zone_flag": "ISZONE",
    "label": "LABEL"
  },
  "extra_attribute_fields": {
    "inode": "i_node",
    "jnode": "j_node",
    "speed_mph": "@speed",
    "free_time_min": "@ftime",
    "lane_capacity": "@emcap",
    "toll": "@toll",
    "tip_id": "@tipid",
    "lane_width_ft": "@width",
    "avg_lane_width_ft": "@avelw",
    "parking_lanes": "@parkl",
    "signal_interconnect": "@sigic",
    "volume": "@vadt",
    "time": "timau"
  },
  "vdf": {
    "functions": {
      "1": {
        "name": "arterial street",
        "alpha": 0.15,
        "exponent": 4,
        "capacity_factor": 0.75,
        "capacity_add": 0,
        "min_term": false,
        "ftime_divisor": 1.0,
        "intersection_delay": true,
        "page": "C vdf_tod.in fd1; A pp.123-124",
        "form": "ul1 [1 + 0.15 (v/ul2)^4] + signal delay from ul3 (@cycle, @gc), capped at one cycle"
      },
      "2": {
        "name": "freeway",
        "alpha": 0.15,
        "exponent": 8,
        "capacity_factor": 0.75,
        "capacity_add": 300,
        "min_term": true,
        "ftime_divisor": 1.15,
        "intersection_delay": false,
        "page": "C vdf_tod.in fd2; A p.124",
        "form": "[1 + 0.15 min(v/ul2, 1)] (ul1 / 1.15) [1 + 0.15 (v / (ul2 + 300))^8]"
      },
      "3": {
        "name": "freeway-arterial ramp",
        "alpha": 0.15,
        "exponent": 4,
        "capacity_factor": 0.75,
        "capacity_add": 0,
        "min_term": false,
        "ftime_divisor": 1.0,
        "intersection_delay": true,
        "page": "C vdf_tod.in fd3; A pp.123-124",
        "form": "same as fd1"
      },
      "4": {
        "name": "expressway",
        "alpha": 0.15,
        "exponent": 8,
        "capacity_factor": 0.75,
        "capacity_add": 0,
        "min_term": true,
        "ftime_divisor": 1.0,
        "intersection_delay": false,
        "page": "C vdf_tod.in fd4; A p.125",
        "form": "[1 + 0.15 min(v/ul2, 1)] ul1 [1 + 0.15 (v/ul2)^8]"
      },
      "5": {
        "name": "freeway-freeway ramp",
        "alpha": 0.15,
        "exponent": 8,
        "capacity_factor": 0.75,
        "capacity_add": 0,
        "min_term": false,
        "ftime_divisor": 1.0,
        "intersection_delay": false,
        "page": "C vdf_tod.in fd5; A p.125",
        "form": "ul1 [1 + 0.15 (v/ul2)^8]"
      },
      "6": {
        "name": "zone centroid connector",
        "alpha": 0.0,
        "exponent": 1,
        "capacity_factor": 1.0,
        "capacity_add": 0,
        "min_term": false,
        "ftime_divisor": 1.0,
        "intersection_delay": false,
        "page": "C vdf_tod.in fd6 = length x 3 (20 mph)",
        "form": "fixed: t = length x 3 min"
      },
      "7": {
        "name": "toll collection link",
        "alpha": 0.0,
        "exponent": 1,
        "capacity_factor": 1.0,
        "capacity_add": 0,
        "min_term": false,
        "ftime_divisor": 1.0,
        "intersection_delay": false,
        "page": "C vdf_tod.in fd7 = ul1; A p.126",
        "form": "fixed: t = @ftime (speed of incoming link); no capacity constraint"
      },
      "8": {
        "name": "metered entrance ramp",
        "alpha": 0.15,
        "exponent": 10,
        "capacity_factor": 1.0,
        "capacity_add": 0,
        "min_term": false,
        "ftime_divisor": 1.0,
        "intersection_delay": false,
        "page": "C vdf_tod.in fd8; A pp.125-126",
        "form": "ul1 [1 + 0.15 (v/ul2)^10], ul2 = 720 x lanes x hours"
      }
    },
    "free_speed_rules_source": "C Database/macros/Ftime_capacity.py",
    "no_capacity_links": {
      "vdf_codes": [
        6,
        7
      ],
      "capacity_placeholder": 99999,
      "vdf_type": 0,
      "alpha": 0.0,
      "beta": 1.0,
      "capacity_source_label": "placeholder_no_constraint"
    }
  },
  "toll": {
    "fixed_vdf_codes": [
      7
    ]
  },
